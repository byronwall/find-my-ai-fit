# Required for AI SDK calls to OpenAI.
OPENAI_API_KEY=your_openai_api_key_here

# App-level model defaults.
OPENAI_MODEL=gpt-5-mini
OPENAI_HEAVY_MODEL=gpt-5.4

# Docker/deployment settings. APP_PORT is the host port published by Compose.
APP_PORT=3000
BASE_PATH=/

# Public URL used for Stripe redirects and magic links. Coolify supplies
# SERVICE_URL_APP automatically; set APP_BASE_URL for other deployments.
SERVICE_URL_APP=
APP_BASE_URL=http://localhost:3000
PRODUCT_NAME=Find My AI Fit

# Persistent server data directory. Docker Compose mounts a named volume here.
APP_DATA_DIR=app/data

# File-backed auth/admin. Resend values are required only when
# EMAIL_DELIVERY=resend; console mode logs magic links instead.
EMAIL_DELIVERY=console
RESEND_API_KEY=your_resend_api_key_here
EMAIL_FROM="Find My AI Fit <support@example.com>"
SUPER_USER_EMAIL=owner@example.com

# Optional Stripe credit-pack billing. Set all three Stripe values together.
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
STRIPE_PRICE_CREDIT_PACK=price_your_credit_pack_price_here
CREDIT_PACK_CREDITS=10
CREDIT_PACK_AMOUNT_CENTS=1000
CREDIT_PACK_CURRENCY=usd
